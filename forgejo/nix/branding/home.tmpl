{{/* MapLibre's welcome text instead of Forgejo's logo, tagline and feature list. */}}
{{template "base/head" .}}
<style>
	/* Center the text between the navigation bar and the footer. */
	.full.height { display: flex; flex-direction: column; padding-bottom: 0; }
	.page-content.home { flex-grow: 1; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 18px; line-height: 1.5; }
	.page-content.home .welcome { max-width: 36em; padding: 0 1rem; text-wrap: balance; }
	.page-content.home h1 { font-size: 2rem; font-weight: 600; line-height: 1.25; margin: 0 0 1rem; }
	.page-content.home p { margin: 0; }
	.page-content.home a { white-space: nowrap; }
</style>
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home">
	<div class="welcome">
		<h1>Welcome to code.maplibre.org!</h1>
		<p>The source code of MapLibre projects lives on our <a href="https://github.com/maplibre">GitHub organization</a>. We mirror some repositories on this <a href="https://forgejo.org/">Forgejo</a> instance.</p>
	</div>
</div>
{{template "base/footer" .}}
